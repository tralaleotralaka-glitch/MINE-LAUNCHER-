<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape><solid android:color="#FF1B2A12" /><stroke android:width="2dp" android:color="#FF0A1206" /></shape></item>
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape><solid android:color="#FF4F8A28" /><stroke android:width="2dp" android:color="#FF9CE05E" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="#FF0A1206" /></shape></item>
            <item android:top="3dp" android:left="3dp">
                <shape>
                    <gradient android:angle="270" android:startColor="#FF79C443" android:endColor="#FF47821F" />
                    <stroke android:width="2dp" android:color="#FFA9EC6B" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
